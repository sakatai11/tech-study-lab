{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tech-study-lab-web",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "services": [
    { "binding": "API", "service": "tech-study-lab-api", "entrypoint": "InternalApi" },
    { "binding": "WORKER_SELF_REFERENCE", "service": "tech-study-lab-web" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "tech-study-lab-web-cache" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
