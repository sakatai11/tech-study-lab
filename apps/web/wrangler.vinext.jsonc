{
  // PoC 専用の新規 Worker 名を使い、production の v1/v2 migration 履歴には触れない。
  // React の開発用 RSC クライアントが WeakRef を使うため、OpenNext と同じ互換日付のまま有効化する。
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "vinext/server/fetch-handler",
  "name": "tech-study-lab-web-vinext",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_weak_ref"],
  "services": [{ "binding": "API", "service": "tech-study-lab-api", "entrypoint": "InternalApi" }],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/_vinext/static-cache/*"]
  },
  "env": {
    "edge": {
      "name": "tech-study-lab-web-vinext",
      "services": [
        { "binding": "API", "service": "tech-study-lab-api-vinext", "entrypoint": "InternalApi" }
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "preview_urls": false
    }
  }
}
