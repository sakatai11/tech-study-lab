{
  "name": "tech-study-lab",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm design-ref:test && pnpm deployment:test && pnpm -r test",
    "lint": "biome check . && depcruise apps packages --config .dependency-cruiser.cjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "pnpm -r build",
    "architecture:extract": "node scripts/architecture.mjs extract",
    "architecture:check": "node scripts/architecture.mjs check",
    "architecture:query": "node scripts/architecture.mjs query",
    "architecture:test": "node --test scripts/architecture.test.mjs architecture/viewer/tests/graph*.test.mjs",
    "architecture:view": "npm --prefix architecture/viewer run dev",
    "architecture:viewer:test": "node --test architecture/viewer/tests/graph*.test.mjs",
    "migration:check-immutable": "node scripts/check-migration-immutability.mjs",
    "migration:test": "node --test scripts/check-migration-immutability.test.mjs",
    "dev": "pnpm --parallel --filter @tsl/api --filter @tsl/web dev",
    "dev:web": "pnpm --filter @tsl/web dev",
    "dev:api": "pnpm --filter @tsl/api dev",
    "content:validate": "pnpm --filter @tsl/api content:validate",
    "content:sync": "pnpm --filter @tsl/api content:sync",
    "sync:agents": "node scripts/sync-agent-config.mjs",
    "test:hooks": "sh scripts/test-hooks.sh",
    "test:secrets": "sh .ai/scripts/test-load-secrets.sh",
    "deployment:test": "node --test scripts/deployment*.test.mjs scripts/performance.test.mjs",
    "design-ref:check": "node scripts/check-design-references.mjs",
    "design-ref:review": "node scripts/review-design-references.mjs",
    "design-ref:test": "node --test scripts/design-references.test.mjs scripts/review-design-references.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "dependency-cruiser": "18.1.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.4.2",
    "typescript": "5.7.3",
    "undici": "7.30.1"
  }
}
